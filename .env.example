# Run npm run setup to create local server settings.
HOST=127.0.0.1
PORT=3200
DATA_DIR=./data
APP_KEY=replace-with-64-hex-characters
# Generate with: read -s ADMIN_PASSWORD; export ADMIN_PASSWORD; npm run admin:hash; unset ADMIN_PASSWORD
# ADMIN_PASSWORD_HASH=scrypt:replace-with-generated-value
# Set this to the exact browser origin when using an HTTPS reverse proxy.
# PUBLIC_ORIGIN=https://your-workbench.example.com
# Keys for built-in groups. They stay on the server and are never sent to the browser.
# MODEL_KEY_GRT_PRO=
# MODEL_KEY_GPT_ENTERPRISE=
# MODEL_KEY_GPT_OFFICIAL=
# MODEL_KEY_GPT_WELFARE=
# MODEL_KEY_CLAUDE_OPUS_5_5=
